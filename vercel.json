{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/download/apk",
      "destination": "/download/extension",
      "permanent": false
    },
    {
      "source": "/download/extension",
      "destination": "https://github.com/kvynshgautam/kyper-website/releases/latest/download/Kyper-extension.zip",
      "permanent": false
    },
    {
      "source": "/downloads/Kyper-latest.apk",
      "destination": "/download/extension",
      "permanent": false
    },
    {
      "source": "/downloads/Kyper-extension.zip",
      "destination": "https://github.com/kvynshgautam/kyper-website/releases/latest/download/Kyper-extension.zip",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/updates", "destination": "/data/updates.json" },
    { "source": "/api/(.*)", "destination": "https://kyper.onrender.com/api/$1" },
    { "source": "/admin/(.*)", "destination": "https://kyper.onrender.com/admin/$1" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
